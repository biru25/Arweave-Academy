---
layout: base.njk
---
<article class="post">
    <header class="post-head">
        <span class="chip">{{ tags | join(" / ") if tags else "post" }}</span>
        <h1>{{ title }}</h1>
        <p class="post-meta">
            <time datetime="{{ date | readableDate }}">{{ date | readableDate }}</time>
            &middot; by {{ site.author }}
        </p>
    </header>

    <div class="prose">
        {{ content | safe }}
    </div>

    <footer class="post-foot">
        <a href="/blog/" class="btn btn-ghost">&larr; Back to all posts</a>
    </footer>
</article>
